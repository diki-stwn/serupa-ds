{
  "name": "serupa-ds",
  "version": "8.1.0",
  "private": true,
  "type": "module",
  "description": "Serupa, a design system by Diki: tokens, utility classes, page defaults, automatic dark mode and React components. Import the components as ES modules (React 19 is a peer dependency), or load dist/serupa.iife.js on a plain page, where it reads window.React (React 19 ships in dist/lib/).",
  "author": "Diki (https://github.com/diki-stwn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diki-stwn/serupa-ds.git"
  },
  "homepage": "https://github.com/diki-stwn/serupa-ds#readme",
  "bugs": {
    "url": "https://github.com/diki-stwn/serupa-ds/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./dist/base.css",
    "./bundle.css": "./dist/bundle.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./serupa.iife.js": "./dist/serupa.iife.js",
    "./serupa-icons.iife.js": "./dist/serupa-icons.iife.js",
    "./theme.js": "./dist/theme.js",
    "./components.json": "./dist/components.json",
    "./design-tokens/*": "./design-tokens/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "serupa-purge": "./bin/serupa-purge.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "tokens.css",
    "tokens.json",
    "fonts/",
    "licenses/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/theme.js",
    "./dist/serupa.iife.js",
    "./dist/serupa-icons.iife.js"
  ],
  "scripts": {
    "build": "node tools/build/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p . && node node_modules/typescript/bin/tsc -p tools",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "node tools/build/build.mjs",
    "pretest": "node tools/build/build.mjs",
    "test": "node tools/test/run.mjs",
    "tokens": "node tools/tokens/build.mjs && node tools/tokens/export.mjs",
    "test:safari": "node tools/test/run.mjs --compat safari",
    "test:firefox": "node tools/test/run.mjs --browser firefox",
    "test:webkit": "node tools/test/run.mjs --browser webkit",
    "changeset": "changeset",
    "version-packages": "node tools/version.mjs",
    "release": "node tools/publish.mjs",
    "lint": "node tools/utilities/build.mjs && eslint . && stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test:coverage": "vitest run --project components --coverage",
    "test:unit": "vitest run --project components",
    "test:checks": "vitest run --project checks",
    "test:watch": "vitest --project components"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "style-dictionary": "5.7.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
