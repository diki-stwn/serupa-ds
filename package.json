{
  "name": "serupa-ds",
  "version": "13.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Serupa, a design system by Diki: tokens, utility classes, page defaults, automatic dark mode and React components. Import the components as ES modules (React 19 is a peer dependency), or load dist/serupa.iife.js on a plain page, where it reads window.React (React 19 ships in dist/lib/).",
  "author": "Diki (https://github.com/diki-stwn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diki-stwn/serupa-ds.git"
  },
  "homepage": "https://github.com/diki-stwn/serupa-ds#readme",
  "bugs": {
    "url": "https://github.com/diki-stwn/serupa-ds/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./dist/base.css",
    "./bundle.css": "./dist/bundle.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./utilities-extra.css": "./dist/utilities-extra.css",
    "./serupa.iife.js": "./dist/serupa.iife.js",
    "./serupa-icons.iife.js": "./dist/serupa-icons.iife.js",
    "./theme.js": "./dist/theme.js",
    "./debug.js": "./dist/debug.js",
    "./components.json": "./dist/components.json",
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js",
      "default": "./dist/eslint.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "import": "./dist/stylelint.js",
      "default": "./dist/stylelint.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./purge": {
      "types": "./dist/purge.d.ts",
      "import": "./dist/purge.js",
      "default": "./dist/purge.js"
    },
    "./design-tokens/*": "./design-tokens/*",
    "./vscode/*": "./dist/vscode/*",
    "./native/*": "./dist/native/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "serupa-purge": "./bin/serupa-purge.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "tokens.css",
    "tokens.json",
    "fonts/",
    "licenses/",
    "skills/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/theme.js",
    "./dist/debug.js",
    "./dist/serupa.iife.js",
    "./dist/serupa-icons.iife.js"
  ],
  "scripts": {
    "build": "node tools/build/build.mjs",
    "typecheck": "node tools/build/registry.mjs && node node_modules/typescript/bin/tsc -p . && node node_modules/typescript/bin/tsc -p tools",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "node tools/build/build.mjs",
    "pretest": "node tools/build/build.mjs",
    "test": "node tools/test/run.mjs",
    "tokens": "node tools/tokens/build.mjs && node tools/tokens/export.mjs && node tools/tokens/readme-tables.mjs && node tools/tokens/badge-palette.mjs",
    "test:safari": "node tools/test/run.mjs --compat safari",
    "test:firefox": "node tools/test/run.mjs --browser firefox",
    "test:webkit": "node tools/test/run.mjs --browser webkit",
    "changeset": "changeset",
    "new-component": "node tools/new-component.mjs",
    "version-packages": "node tools/version.mjs",
    "release": "node tools/publish.mjs",
    "lint": "node tools/utilities/build.mjs && node tools/build/registry.mjs && eslint . && stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test:coverage": "vitest run --project components --coverage",
    "test:unit": "vitest run --project components",
    "test:aria:update": "SERUPA_UPDATE_ARIA=1 vitest run --project components src/internal/ariaStories.test.tsx",
    "test:server-html:update": "SERUPA_UPDATE_SERVER_HTML=1 vitest run --project components src/internal/serverHtml.test.tsx",
    "test:checks": "vitest run --project checks",
    "test:watch": "vitest --project components"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@mdn/browser-compat-data": "8.1.7",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "ajv": "^8.20.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "lightningcss": "1.33.0",
    "playwright": "1.64.1",
    "postcss-value-parser": "4.2.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.14",
    "rollup": "4.64.10",
    "storybook": "10.6.5",
    "style-dictionary": "5.7.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "sucrase": "^3.35.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
