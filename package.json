{
  "name": "serupa-ds",
  "version": "13.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Serupa, a design system by Diki: tokens, utility classes, page defaults, automatic dark mode and React components. Import the components as ES modules (React 19 is a peer dependency), or load dist/serupa.iife.js on a plain page, where it reads window.React (React 19 ships in dist/lib/).",
  "author": "Diki (https://github.com/diki-stwn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diki-stwn/serupa-ds.git"
  },
  "homepage": "https://github.com/diki-stwn/serupa-ds#readme",
  "bugs": {
    "url": "https://github.com/diki-stwn/serupa-ds/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./dist/base.css",
    "./bundle.css": "./dist/bundle.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./utilities-extra.css": "./dist/utilities-extra.css",
    "./serupa.iife.js": "./dist/serupa.iife.js",
    "./serupa-icons.iife.js": "./dist/serupa-icons.iife.js",
    "./theme.js": "./dist/theme.js",
    "./debug.js": "./dist/debug.js",
    "./components.json": "./dist/components.json",
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js",
      "default": "./dist/eslint.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "import": "./dist/stylelint.js",
      "default": "./dist/stylelint.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./purge": {
      "types": "./dist/purge.d.ts",
      "import": "./dist/purge.js",
      "default": "./dist/purge.js"
    },
    "./design-tokens/*": "./design-tokens/*",
    "./vscode/*": "./dist/vscode/*",
    "./native/*": "./dist/native/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "serupa-purge": "./bin/serupa-purge.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "tokens.css",
    "tokens.json",
    "fonts/",
    "licenses/",
    "skills/",
    "design-tokens/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/theme.js",
    "./dist/debug.js",
    "./dist/serupa.iife.js",
    "./dist/serupa-icons.iife.js"
  ],
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
