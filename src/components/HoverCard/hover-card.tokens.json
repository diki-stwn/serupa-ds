{
  "hoverCard": {
    "$description": "HoverCard's component tokens. Each one is an optional override: set the CSS variable (--hover-card-<name>) on the page, a container or one HoverCard, and every HoverCard inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "The card's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-bg"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The card's text (4.5:1 on bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "The card's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-border"
          }
        }
      }
    },
    "shadow": {
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.shadow-lg}",
        "$description": "The card's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-shadow"
          }
        }
      }
    },
    "border": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-lg}",
        "$description": "The corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-radius"
          }
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "The border's width (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-border-width"
          }
        }
      }
    },
    "sizing": {
      "width": {
        "$type": "dimension",
        "$value": "{sizing.container-xs}",
        "$description": "The card's width (320px), never wider than the screen.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-width"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space inside, on every side (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-padding"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "The gap between the link and the card (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-offset"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-popover}",
        "$description": "Its stacking level, for a browser without the top layer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--hover-card-z-index"
          }
        }
      }
    }
  }
}
