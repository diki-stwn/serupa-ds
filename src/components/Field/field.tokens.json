{
  "field": {
    "$description": "Field's component tokens. Each one is an optional override: set the CSS variable (--field-<name>) on the page, a container or one field, and every Field inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Text with no token of its own (the label, hint and error have theirs)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-text"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-color"
          }
        }
      },
      "hint-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "Hint and \"(optional)\"",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-hint-color"
          }
        }
      },
      "error-color": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "Error message and its icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-color"
          }
        }
      },
      "required-color": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "The `*`",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-required-color"
          }
        }
      }
    },
    "typography": {
      "label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Label weight (500)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-weight"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Space between label, hint, control and error (6px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-gap"
          }
        }
      },
      "error-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Error icon to text (4px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-gap"
          }
        }
      },
      "column-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "`layout=\"horizontal\"`: label column to control (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-column-gap"
          }
        }
      }
    },
    "sizing": {
      "error-icon-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Error icon (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-icon-size"
          }
        }
      },
      "label-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "`layout=\"horizontal\"`: the label column (192px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-width"
          }
        }
      },
      "control-min-width": {
        "$type": "dimension",
        "$value": "{sizing.container-3xs}",
        "$description": "`layout=\"horizontal\"`: the narrowest control column before it wraps under the label (256px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-control-min-width"
          }
        }
      }
    }
  }
}
