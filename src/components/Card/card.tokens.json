{
  "card": {
    "$description": "Card's component tokens. Each one is an optional override: set the CSS variable (--card-<name>) on the page, a container or one card, and every Card inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The card's background (outline and elevated cards).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-bg"
          }
        }
      },
      "bg-filled": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The background of a filled card.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-bg-filled"
          }
        }
      },
      "bg-elevated": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "The background of an elevated card: one step up from the page in dark.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-bg-elevated"
          }
        }
      },
      "border-elevated": {
        "$type": "color",
        "$value": "{color.border-raised}",
        "$description": "An elevated card's edge: invisible in light, a 1px lighter edge in dark, where the shadow doesn't show.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-border-elevated"
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The border of an outline card.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-border"
          }
        }
      },
      "title-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The title.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-title-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description under the title (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-description-color"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The card's text: the body and the footer (the title and description have their own tokens).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-text"
          }
        }
      },
      "hover-border-color": {
        "$type": "color",
        "$value": "{color.border-strong}",
        "$description": "The border of an interactive card while hovered.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-border-hover"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "A linked card's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-focus-ring"
          }
        }
      }
    },
    "shadow": {
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.shadow-xs}",
        "$description": "An outline card's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-shadow"
          }
        }
      },
      "shadow-elevated": {
        "$type": "shadow",
        "$value": "{shadow.shadow-md}",
        "$description": "An elevated card's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-shadow-elevated"
          }
        }
      }
    },
    "border": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-xl}",
        "$description": "The corner radius (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-radius"
          }
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "The border width of an outline card.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-border-width"
          }
        }
      }
    },
    "spacing": {
      "padding-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Padding with padding=\"sm\" (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-padding-sm"
          }
        }
      },
      "padding-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Padding with padding=\"md\", the default (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-padding-md"
          }
        }
      },
      "padding-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "Padding with padding=\"lg\" (24px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-padding-lg"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space between the header, body and footer (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-gap"
          }
        }
      },
      "header-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between the title and the description (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-header-gap"
          }
        }
      }
    },
    "typography": {
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The title's weight (600).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-title-weight"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-97}",
        "$description": "Size of a card with href while it's held down (97%). 1 turns press feedback off.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--card-press-scale"
          }
        }
      }
    }
  }
}
