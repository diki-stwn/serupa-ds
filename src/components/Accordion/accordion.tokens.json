{
  "accordion": {
    "$description": "Accordion's component tokens. Each one is an optional override: set the CSS variable (--accordion-<name>) on the page, a container or one accordion, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The lines between items, and the frame of variant=\"card\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-border"
          }
        }
      },
      "title": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "An item's title.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-title-color"
          }
        }
      },
      "content": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "An item's content (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-content-color"
          }
        }
      },
      "icon": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The chevron.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-icon-color"
          }
        }
      },
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The background of variant=\"card\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-bg"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-focus-ring"
          }
        }
      },
      "trigger-bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A title's fill while it's held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-trigger-bg-pressed"
          }
        }
      }
    },
    "typography": {
      "title-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Title text (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-title-size"
          }
        }
      },
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Title weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-title-weight"
          }
        }
      },
      "content-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Content text (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-content-size"
          }
        }
      }
    },
    "spacing": {
      "padding-y": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space above and below a title, and below the content (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-padding-y"
          }
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Side padding in variant=\"card\" (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-padding-x"
          }
        }
      }
    },
    "sizing": {
      "icon-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "The chevron (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-icon-size"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Lines and frame (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-border-width"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-lg}",
        "$description": "The corners of variant=\"card\" (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-radius"
          }
        }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "{transitions.motion-change-md}",
        "$description": "Opening: the fade, unfold and height (200ms), and the chevron turning. Closing folds back and shrinks over motion-exit-md (150ms).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--accordion-duration"
          }
        }
      }
    }
  }
}
