{
  "radio": {
    "$description": "Radio's and RadioGroup's component tokens. Each one is an optional override: set the CSS variable (--radio-<name>) on the page, a container or one radio, and every Radio inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The circle's background while unchecked.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The circle's background when disabled and unchecked.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked (3:1 on the page in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "Fill and border when checked, on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked-hover"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "The circle's border while unchecked (3:1 on the field and the page).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "The border on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-hover"
          }
        }
      },
      "dot-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The dot in a checked radio.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description (4.5:1 on the page).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Border and focus ring when invalid.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-invalid"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Circle size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Circle size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Circle size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-lg"
          }
        }
      },
      "dot-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, sm (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-sm"
          }
        }
      },
      "dot-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, md (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-md"
          }
        }
      },
      "dot-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Dot size, lg (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-lg"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Gap between the circle and the label (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Gap between radios in a vertical group, and between rows of a horizontal one (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Gap between radios in a horizontal group (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap-horizontal"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "The circle's border width (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-width"
          }
        }
      }
    }
  }
}
