{
  "button": {
    "$description": "Button's component tokens. Each one is an optional override: set the CSS variable (--button-<name>) on the page, a container or one button, and every Button inside follows. Unset, it uses the shared token it references here, resolved in the button's own theme. tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "primary-bg": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Primary background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-primary-bg"
          }
        }
      },
      "primary-bg-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "Primary background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-primary-bg-hover"
          }
        }
      },
      "primary-text": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "Primary text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-primary-text"
          }
        }
      },
      "secondary-bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "Secondary background: `surface-raised`, white in light and a step above the page in dark (an outline in the brand color).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-bg"
          }
        }
      },
      "secondary-bg-hover": {
        "$type": "color",
        "$value": "{color.primary-subtle}",
        "$description": "Secondary background on hover: a tint of the brand color.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-bg-hover"
          }
        }
      },
      "secondary-text": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Secondary label and icon color: the brand color (4.5:1+ on surface in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-text"
          }
        }
      },
      "secondary-text-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "Secondary label and icon color on hover (4.5:1+ on the hover tint in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-text-hover"
          }
        }
      },
      "secondary-border": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Secondary border: the brand color (3:1+ on surface in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-border"
          }
        }
      },
      "secondary-border-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "Secondary border on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-secondary-border-hover"
          }
        }
      },
      "outline-bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "Outline background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-outline-bg"
          }
        }
      },
      "outline-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "Outline background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-outline-bg-hover"
          }
        }
      },
      "outline-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Outline text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-outline-text"
          }
        }
      },
      "outline-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "Outline border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-outline-border"
          }
        }
      },
      "ghost-bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0,
          "hex": "#000000"
        },
        "$description": "Ghost background (transparent).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-ghost-bg"
          }
        }
      },
      "ghost-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "Ghost background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-ghost-bg-hover"
          }
        }
      },
      "ghost-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Ghost text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-ghost-text"
          }
        }
      },
      "link-text": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Link text.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-link-text"
          }
        }
      },
      "destructive-primary-bg": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Destructive primary background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-primary-bg"
          }
        }
      },
      "destructive-primary-bg-hover": {
        "$type": "color",
        "$value": "{color.danger-hover}",
        "$description": "Destructive primary background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-primary-bg-hover"
          }
        }
      },
      "destructive-primary-text": {
        "$type": "color",
        "$value": "{color.on-danger}",
        "$description": "Destructive primary text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-primary-text"
          }
        }
      },
      "destructive-secondary-bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "Destructive secondary background: `surface-raised`, white in light and a step above the page in dark (an outline in red).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-secondary-bg"
          }
        }
      },
      "destructive-secondary-bg-hover": {
        "$type": "color",
        "$value": "{color.danger-subtle}",
        "$description": "Destructive secondary background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-secondary-bg-hover"
          }
        }
      },
      "destructive-secondary-text": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "Destructive secondary text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-secondary-text"
          }
        }
      },
      "destructive-secondary-border": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Destructive secondary border: solid red (3:1+ on surface), stronger than the destructive outline's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-secondary-border"
          }
        }
      },
      "destructive-outline-bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "Destructive outline background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-outline-bg"
          }
        }
      },
      "destructive-outline-bg-hover": {
        "$type": "color",
        "$value": "{color.danger-subtle}",
        "$description": "Destructive outline background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-outline-bg-hover"
          }
        }
      },
      "destructive-outline-text": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "Destructive outline text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-outline-text"
          }
        }
      },
      "destructive-outline-border": {
        "$type": "color",
        "$value": "{color.danger-border}",
        "$description": "Destructive outline border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-outline-border"
          }
        }
      },
      "destructive-ghost-bg-hover": {
        "$type": "color",
        "$value": "{color.danger-subtle}",
        "$description": "Destructive ghost background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-ghost-bg-hover"
          }
        }
      },
      "destructive-ghost-text": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "Destructive ghost text and icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-ghost-text"
          }
        }
      },
      "destructive-link-text": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "Destructive link text.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-link-text"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "Keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-focus-ring"
          }
        }
      },
      "destructive-focus-ring": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Keyboard focus ring on a destructive button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-destructive-focus-ring"
          }
        }
      }
    },
    "spacing": {
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding, sm (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-padding-x-sm"
          }
        }
      },
      "padding-x-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Side padding, md (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-padding-x-md"
          }
        }
      },
      "padding-x-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Side padding, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-padding-x-lg"
          }
        }
      },
      "gap-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Gap between icon and label, sm (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-gap-sm"
          }
        }
      },
      "gap-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Gap between icon and label, md (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-gap-md"
          }
        }
      },
      "gap-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Gap between icon and label, lg (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-gap-lg"
          }
        }
      },
      "icon-offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Extra padding on the text side of a button with one icon, which reads lighter than text (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-offset"
          }
        }
      },
      "padding-y-wrap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Top and bottom padding of a wrap button, md and lg, whose label can take more than one line (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-padding-y-wrap"
          }
        }
      },
      "padding-y-wrap-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "Top and bottom padding of a wrap button, sm (2px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-padding-y-wrap-sm"
          }
        }
      }
    },
    "sizing": {
      "height-sm": {
        "$type": "dimension",
        "$value": "{sizing.control-height-sm}",
        "$description": "Height, sm (24px); also the width of an icon-only sm button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-height-sm"
          }
        }
      },
      "height-md": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "Height, md (32px); also the width of an icon-only md button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-height-md"
          }
        }
      },
      "height-lg": {
        "$type": "dimension",
        "$value": "{sizing.control-height-lg}",
        "$description": "Height, lg (44px); also the width of an icon-only lg button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-height-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Icon size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Icon size, md (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Icon size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-size-lg"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px; drawn on outline buttons, invisible on the others but shown in forced-colors mode).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-md}",
        "$description": "Corner radius (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-97}",
        "$description": "Size while pressed (97%). 1 turns press feedback off.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-press-scale"
          }
        }
      },
      "press-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-press}",
        "$description": "How fast the press scales down and back (100ms).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-press-duration"
          }
        }
      },
      "icon-nudge": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0}",
        "$description": "How far a right icon slides on hover. Off by default (0); set it to {spacing.spacing-0_5} (2px) where right icons are forward arrows.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-nudge"
          }
        }
      },
      "icon-nudge-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-change-sm}",
        "$description": "How fast the right icon slides (150ms).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-icon-nudge-duration"
          }
        }
      },
      "loading-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-enter-sm}",
        "$description": "Cross-fade between the content and the loading spinner (150ms).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--button-loading-duration"
          }
        }
      }
    }
  }
}
