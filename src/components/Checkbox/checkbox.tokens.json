{
  "checkbox": {
    "$description": "Checkbox's component tokens. Each one is an optional override: set the CSS variable (--checkbox-<name>) on the page, a container or one checkbox, and every Checkbox inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The box while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The box when disabled and unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked or indeterminate",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The same, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked-hover"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-hover"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The check and the dash",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Border and focus ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-invalid"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Box size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Box size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Box size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Check size, sm (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Check size, md (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Check size, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-lg"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Box to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Between boxes in a CheckboxGroup stack, and between rows (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Between boxes in a CheckboxGroup row (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap-horizontal"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-sm}",
        "$description": "Corner radius (4px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-90}",
        "$description": "Size of the box while it's held down (90%). 1 turns it off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-press-scale"
          }
        }
      }
    }
  }
}
