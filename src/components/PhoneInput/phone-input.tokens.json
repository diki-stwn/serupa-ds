{
  "phone-input": {
    "$description": "PhoneInput's component tokens. Each one is an optional override: set the CSS variable (--phone-input-<name>) on the page, a container or one field, and everything inside follows. Unset, it uses the shared token it references here; the box and the tel field follow Input's tokens. tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "dial": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The calling code (4.5:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-dial"
          }
        }
      },
      "chevron": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The chevron (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-chevron"
          }
        }
      },
      "divider": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The line between the country part and the number.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-divider"
          }
        }
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The country part's background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-bg-hover"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The menu's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-focus-ring"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space around the chevron (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--phone-input-gap"
          }
        }
      }
    }
  }
}
