{
  "textarea": {
    "$description": "Textarea's component tokens. Each one is an optional override: set the CSS variable (--textarea-<name>) on the page, a container or one textarea, and every Textarea inside follows. Unset, it uses the shared token it references here, the same ones Input uses; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "Field background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-bg"
          }
        }
      },
      "bg-readonly": {
        "$type": "color",
        "$value": "{color.field-readonly}",
        "$description": "Background when read-only or disabled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-bg-readonly"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The typed text.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border (3:1 on the field and the page in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-border-hover"
          }
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.placeholder}",
        "$description": "Placeholder text (4.5:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-placeholder"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "Border and ring while focused.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Border and focus ring when invalid.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-invalid"
          }
        }
      },
      "count": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The character count (showCount), 4.5:1 on the field; it turns text-colored at maxLength.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-count"
          }
        }
      },
      "count-full": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The character count once it reaches maxLength.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-count-full"
          }
        }
      }
    },
    "spacing": {
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding, sm (8px), like Input sm.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-x-sm"
          }
        }
      },
      "padding-x-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Side padding, md (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-x-md"
          }
        }
      },
      "padding-x-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Side padding, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-x-lg"
          }
        }
      },
      "padding-y-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Top and bottom padding, sm (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-y-sm"
          }
        }
      },
      "padding-y-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Top and bottom padding, md (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-y-md"
          }
        }
      },
      "padding-y-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2_5}",
        "$description": "Top and bottom padding, lg (10px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-padding-y-lg"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px); the focus ring adds as much again.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-md}",
        "$description": "Corner radius (6px), like Input and Button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--textarea-radius"
          }
        }
      }
    }
  }
}
