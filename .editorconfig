# The repository's whitespace, for editors and agents that read EditorConfig (https://editorconfig.org).
# Every file already follows it. It sets whitespace only: there is no formatter (tools/README.md, Setup).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Two spaces at a line's end are a line break in Markdown.
[*.{md,mdx}]
trim_trailing_whitespace = false

# Written by the tests (--update, or the Update baselines workflow), never by hand.
[tools/test/baseline-*]
insert_final_newline = unset
