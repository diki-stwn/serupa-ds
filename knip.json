{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts!",
    "src/icons.ts!",
    "src/browser.ts!",
    "src/browser-icons.ts!",
    "src/theme.js!",
    "src/debug.js!",
    "src/stylelint.js!",
    "src/testing.js!",
    "src/purge.js!",
    "bin/*.mjs!",
    "tools/**/*.mjs",
    "src/**/*.stories.tsx",
    "src/**/*.test.{ts,tsx}",
    ".storybook/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js}!",
    "tools/**/*.mjs",
    "bin/*.mjs!",
    ".storybook/*.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "ignoreDependencies": [
    "@arethetypeswrong/cli"
  ]
}
