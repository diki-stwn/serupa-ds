      "css": "spin 1s linear infinite",
      "description": "`animate-spin`: loading spinners (Button uses it)."
    },
    "animate-spin-reduced": {
      "css": "spin 3s linear infinite",
      "description": "`animate-spin` when the viewer prefers reduced motion: the same turn, three times slower. Applied automatically."
    },
    "animate-ping": {
      "css": "ping 1s cubic-bezier(0, 0, 0.2, 1) infinite",
      "description": "`animate-ping`: a radar ping behind a notification dot or live badge."
    },
    "animate-pulse": {
      "css": "pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite",
      "description": "`animate-pulse`: skeleton placeholders while content loads."
    },
    "animate-bounce": {
      "css": "bounce 1s infinite",
      "description": "`animate-bounce`: a scroll-down hint. Use sparingly."
    }
