{
  "$description": "Tokens the W3C Design Tokens format (2025.10) has no type for yet: degrees, em, percentages of a box, viewport units, keywords, CSS shorthands, and text shadows (the shadow type in the format always has a spread, which CSS text-shadow does not allow). Use the CSS value as-is.",
  "shadow": {
    "text-shadow-2xs": {
      "css": "0px 1px 0px rgb(0 0 0 / 0.15)",
      "description": "`text-shadow-2xs`. Crisp edge on small text over images."
    },
    "text-shadow-xs": {
      "css": "0px 1px 1px rgb(0 0 0 / 0.2)",
      "description": "`text-shadow-xs`. Text over busy backgrounds."
    },
    "text-shadow-sm": {
      "css": "0px 1px 0px rgb(0 0 0 / 0.075), 0px 1px 1px rgb(0 0 0 / 0.075), 0px 2px 2px rgb(0 0 0 / 0.075)",
      "description": "`text-shadow-sm`. Headings over photos."
    },
    "text-shadow-md": {
      "css": "0px 1px 1px rgb(0 0 0 / 0.1), 0px 1px 2px rgb(0 0 0 / 0.1), 0px 2px 4px rgb(0 0 0 / 0.1)",
      "description": "`text-shadow-md`. Large display text."
    },
    "text-shadow-lg": {
      "css": "0px 1px 2px rgb(0 0 0 / 0.1), 0px 3px 2px rgb(0 0 0 / 0.1), 0px 4px 8px rgb(0 0 0 / 0.1)",
      "description": "`text-shadow-lg`. Hero text."
    },
    "text-shadow-none": {
      "css": "none",
      "description": "`text-shadow-none`. Removes a text shadow."
    }
  },
  "typography": {
