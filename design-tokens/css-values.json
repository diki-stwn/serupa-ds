  "transitions": {
    "transition": {
      "css": "opacity, box-shadow, transform, translate, scale, rotate, filter, -webkit-backdrop-filter, backdrop-filter, display, content-visibility, overlay, pointer-events",
      "description": "`transition` (default) animates `transition-colors` plus these: opacity, shadow, transforms, filters and discrete properties like display."
    },
    "transition-colors": {
      "css": "color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --dk-gradient-from, --dk-gradient-via, --dk-gradient-to",
      "description": "`transition-colors`: hover and focus color changes, gradients included."
    },
    "transition-opacity": {
      "css": "opacity",
      "description": "`transition-opacity`: fades."
    },
    "transition-shadow": {
      "css": "box-shadow",
      "description": "`transition-shadow`: elevation changes."
    },
    "transition-transform": {
      "css": "transform, translate, scale, rotate",
      "description": "`transition-transform`: moves, scales and rotations, including the translate/scale/rotate classes."
    },
