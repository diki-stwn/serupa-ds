{
  "badge": {
    "$description": "Badge's component tokens. Each one is an optional override: set the CSS variable (--badge-<name>) on the page, a container or one badge, and every Badge inside follows. Unset, it uses the shared token it references here. Badge colors come from the alias colors (neutral, primary) and the palette (every other tone), with contrast checked in every theme; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "neutral-subtle-bg": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "Neutral subtle: fill",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-subtle-bg"
          }
        }
      },
      "neutral-subtle-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Neutral subtle: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-subtle-text"
          }
        }
      },
      "neutral-solid-bg": {
        "$type": "color",
        "$value": "{color.surface-inverse}",
        "$description": "Neutral solid: fill",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-solid-bg"
          }
        }
      },
      "neutral-solid-text": {
        "$type": "color",
        "$value": "{color.text-inverse}",
        "$description": "Neutral solid: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-solid-text"
          }
        }
      },
      "neutral-outline-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Neutral outline: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-outline-text"
          }
        }
      },
      "neutral-outline-border": {
        "$type": "color",
        "$value": "{color.border-strong}",
        "$description": "Neutral outline: border",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-neutral-outline-border"
          }
        }
      },
      "primary-subtle-bg": {
        "$type": "color",
        "$value": "{color.primary-subtle}",
        "$description": "Primary subtle: fill",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-subtle-bg"
          }
        }
      },
      "primary-subtle-text": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Primary subtle: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-subtle-text"
          }
        }
      },
      "primary-solid-bg": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Primary solid: fill",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-solid-bg"
          }
        }
      },
      "primary-solid-text": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "Primary solid: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-solid-text"
          }
        }
      },
      "primary-outline-text": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Primary outline: text and icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-outline-text"
          }
        }
      },
      "primary-outline-border": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Primary outline: border",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-primary-outline-border"
          }
        }
      },
      "indicator-ring-color": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The indicator's ring color; set it to the color behind",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-indicator-ring-color"
          }
        }
      }
    },
    "sizing": {
      "height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Height (20px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-height"
          }
        }
      },
      "icon-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Icon size (12px): leading icon, ×, loading ring, the dot box's height",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-icon-size"
          }
        }
      },
      "dot-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Status dot (6px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-dot-size"
          }
        }
      },
      "indicator-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "The lone indicator dot (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-indicator-size"
          }
        }
      }
    },
    "spacing": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Side padding (6px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-padding-x"
          }
        }
      },
      "icon-offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "Extra padding on the text side when there's an icon (or dot, or ×) on one side only (2px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-icon-offset"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Gap between the dot or icon, the label and the × (4px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-gap"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (subtle and outline badges, and every badge in forced-colors mode)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-md}",
        "$description": "Corner radius (6px), like Button. Count badges are always fully round",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-radius"
          }
        }
      },
      "subtle-border": {
        "$type": "number",
        "$value": "{opacity.opacity-20}",
        "$description": "Strength of the subtle badge's outline, in its text color (20%). Set `0%` for no outline",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-subtle-border"
          }
        }
      },
      "indicator-ring": {
        "$type": "dimension",
        "$value": "{borders.border-width-2}",
        "$description": "The indicator's ring in the surface color (2px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-indicator-ring"
          }
        }
      }
    },
    "state": {
      "hover-layer": {
        "$type": "number",
        "$value": "{opacity.opacity-10}",
        "$description": "Clickable badges: the hover layer's strength (10%)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-hover-layer"
          }
        }
      },
      "active-layer": {
        "$type": "number",
        "$value": "{opacity.opacity-15}",
        "$description": "Clickable badges: the layer while pressed (15%)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-active-layer"
          }
        }
      },
      "state-text": {
        "$type": "number",
        "$value": "{opacity.opacity-30}",
        "$description": "Clickable subtle and outline badges: how far the text moves toward black (light) or white (dark) on hover and press (30%)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-state-text"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "Clickable badges: the keyboard focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-focus-ring"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-97}",
        "$description": "Clickable badges: size while pressed (97%); `100%` turns it off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-press-scale"
          }
        }
      },
      "press-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-press}",
        "$description": "How fast the press scales down (100ms). The release comes back over `motion-release` with `ease-enter`.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-press-duration"
          }
        }
      },
      "loading-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-enter-sm}",
        "$description": "Cross-fade between the content and the loading ring (150ms)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--badge-loading-duration"
          }
        }
      }
    }
  }
}
