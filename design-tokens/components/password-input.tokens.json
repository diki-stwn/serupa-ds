{
  "password-input": {
    "$description": "PasswordInput's component tokens. Each one is an optional override: set the CSS variable (--password-input-<name>) on the page, a container or one field, and everything inside follows. Unset, it uses the shared token it references here; the field itself follows Input's tokens. tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "toggle": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The show/hide button's icon (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-toggle"
          }
        }
      },
      "toggle-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The icon on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-toggle-hover"
          }
        }
      },
      "toggle-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "The button's background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-toggle-bg-hover"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The button's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-focus-ring"
          }
        }
      },
      "caps": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The Caps Lock hint (4.5:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-caps"
          }
        }
      }
    },
    "radius": {
      "toggle-radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-sm}",
        "$description": "The button's corners (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-toggle-radius"
          }
        }
      }
    },
    "spacing": {
      "toggle-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space around the button's icon (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--password-input-toggle-padding"
          }
        }
      }
    }
  }
}
