{
  "field": {
    "$description": "Field's component tokens. Each one is an optional override: set the CSS variable (--field-<name>) on the page, a container or one field, and every Field inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Text in the field that has no token of its own (the label, hint and error have theirs).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-text"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-color"
          }
        }
      },
      "hint-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The hint (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-hint-color"
          }
        }
      },
      "error-color": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "The error message and its icon (4.5:1+ on surface in every theme).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-color"
          }
        }
      },
      "required-color": {
        "$type": "color",
        "$value": "{color.danger-text}",
        "$description": "The required asterisk.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-required-color"
          }
        }
      }
    },
    "typography": {
      "label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "The label's weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-weight"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Space between the label, hint, control and error (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-gap"
          }
        }
      },
      "error-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between the error icon and its text (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-gap"
          }
        }
      },
      "column-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "layout=\"horizontal\": space between the label column and the control (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-column-gap"
          }
        }
      }
    },
    "sizing": {
      "error-icon-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "The error icon (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-error-icon-size"
          }
        }
      },
      "label-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "layout=\"horizontal\": the label column (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-label-width"
          }
        }
      },
      "control-min-width": {
        "$type": "dimension",
        "$value": "{sizing.container-3xs}",
        "$description": "layout=\"horizontal\": the narrowest the control column gets before it wraps under the label (256px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--field-control-min-width"
          }
        }
      }
    }
  }
}
