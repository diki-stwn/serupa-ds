{
  "combobox": {
    "$description": "Combobox's component tokens. Each one is an optional override: set the CSS variable (--combobox-<name>) on the page, a container or one combobox, and every Combobox inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults. The field itself uses Input's tokens.",
    "color": {
      "chevron": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The chevron button's icon (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-chevron"
          }
        }
      },
      "chevron-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The chevron and clear buttons' icon on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-chevron-hover"
          }
        }
      },
      "chevron-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "The chevron and clear buttons' background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-chevron-bg-hover"
          }
        }
      },
      "listbox-bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "The list's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-bg"
          }
        }
      },
      "listbox-border": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "The list's outline.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-border"
          }
        }
      },
      "option-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "An option's label.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-color"
          }
        }
      },
      "option-bg-active": {
        "$type": "color",
        "$value": "{color.highlight}",
        "$description": "The highlighted option (hover or arrow keys); its muted second line turns to text on it.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-bg-active"
          }
        }
      },
      "option-indicator": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The 2px bar at the highlighted option's start (3:1 on highlight).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-indicator"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "An option's second line, and the empty and loading messages.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-description-color"
          }
        }
      },
      "check": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The check next to the selected option.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-check"
          }
        }
      }
    },
    "shadow": {
      "listbox-shadow": {
        "$type": "shadow",
        "$value": "{shadow.shadow-lg}",
        "$description": "The list's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-shadow"
          }
        }
      }
    },
    "radius": {
      "listbox-radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-lg}",
        "$description": "The list's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-radius"
          }
        }
      },
      "option-radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-md}",
        "$description": "An option's corners (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-radius"
          }
        }
      }
    },
    "sizing": {
      "listbox-max-height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-60}",
        "$description": "The list's height before it scrolls (240px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-max-height"
          }
        }
      },
      "listbox-max-width": {
        "$type": "dimension",
        "$value": "{sizing.container-md}",
        "$description": "The list's widest, unless the field is wider (448px). Longer labels wrap.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-max-width"
          }
        }
      },
      "option-height": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "An option's least height (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-height"
          }
        }
      }
    },
    "spacing": {
      "listbox-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space inside the list (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-listbox-padding"
          }
        }
      },
      "option-padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space on each side of an option (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-option-padding-x"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "The gap between the field and the list (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-offset"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-popover}",
        "$description": "The list's stacking order, where the top layer isn't available.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--combobox-z-index"
          }
        }
      }
    }
  }
}
