{
  "toast": {
    "$description": "Toast's component tokens. Each one is an optional override: set the CSS variable (--toast-<name>) on the page or the Toaster, and every toast follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "A toast's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-bg"
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "A toast's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-border"
          }
        }
      },
      "title-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The title.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-title-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-description-color"
          }
        }
      },
      "icon-info": {
        "$type": "color",
        "$value": "{color.info}",
        "$description": "The icon of an info toast (3:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-icon-info"
          }
        }
      },
      "icon-success": {
        "$type": "color",
        "$value": "{color.success}",
        "$description": "The icon of a success toast.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-icon-success"
          }
        }
      },
      "icon-warning": {
        "$type": "color",
        "$value": "{color.warning}",
        "$description": "The icon of a warning toast.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-icon-warning"
          }
        }
      },
      "icon-danger": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "The icon of a danger toast.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-icon-danger"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The ring around a toast that F8 moved focus to.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-focus-ring"
          }
        }
      }
    },
    "shadow": {
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.shadow-lg}",
        "$description": "A toast's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-shadow"
          }
        }
      }
    },
    "border": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-lg}",
        "$description": "A toast's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-radius"
          }
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "A toast's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-border-width"
          }
        }
      }
    },
    "sizing": {
      "width": {
        "$type": "dimension",
        "$value": "{sizing.container-sm}",
        "$description": "A toast's width (384px), at most the screen less the offset on each side.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-width"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Padding inside a toast (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-padding"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a toast's icon, text and buttons (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-gap"
          }
        }
      },
      "stack-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space between toasts (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-stack-gap"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "The distance from the edges of the screen (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-offset"
          }
        }
      }
    },
    "typography": {
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The title's weight (600).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-title-weight"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-toast}",
        "$description": "The stacking level: above the page and the FAB.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--toast-z-index"
          }
        }
      }
    }
  }
}
