{
  "time-picker": {
    "$description": "TimePicker's component tokens. Each one is an optional override: set the CSS variable (--time-picker-<name>) on the page, a container or one picker, and every TimePicker inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "button": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The clock button's icon (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-button"
          }
        }
      },
      "button-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The clock button's icon on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-button-hover"
          }
        }
      },
      "button-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The clock button's background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-button-bg-hover"
          }
        }
      },
      "list-bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "The list's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-bg"
          }
        }
      },
      "list-border": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "The list's outline.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-border"
          }
        }
      },
      "option-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A time in the list.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-option-color"
          }
        }
      },
      "option-bg-active": {
        "$type": "color",
        "$value": "{color.highlight}",
        "$description": "The highlighted time (pointer or keyboard).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-option-bg-active"
          }
        }
      },
      "option-indicator": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The 2px bar at the highlighted time's start.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-option-indicator"
          }
        }
      },
      "check": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The check by the chosen time (3:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-check"
          }
        }
      }
    },
    "shadow": {
      "list-shadow": {
        "$type": "shadow",
        "$value": "{shadow.shadow-lg}",
        "$description": "The list's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-shadow"
          }
        }
      }
    },
    "border": {
      "list-radius": {
        "$type": "dimension",
        "$value": "{radius.rounded-lg}",
        "$description": "The list's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-radius"
          }
        }
      }
    },
    "sizing": {
      "list-max-height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-60}",
        "$description": "The list's tallest before it scrolls (240px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-max-height"
          }
        }
      },
      "list-min-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-40}",
        "$description": "The list's least width (160px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-min-width"
          }
        }
      },
      "option-height": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "Each time's height (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-option-height"
          }
        }
      }
    },
    "spacing": {
      "list-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space inside the list (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-list-padding"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "The gap between the field and the list (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-offset"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-popover}",
        "$description": "The list's stacking order, where the top layer isn't available.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--time-picker-z-index"
          }
        }
      }
    }
  }
}
