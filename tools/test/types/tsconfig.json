{
  // A project's settings, strict, with the package's own types checked too (skipLibCheck off for them is the point).
  // tools/test/types.mjs compiles consumer.tsx with this, once per module resolution projects use.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "files": ["consumer.tsx"]
}
